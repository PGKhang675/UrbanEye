# Backend API base URL (FastAPI). Local dev uses Vite proxy (/api -> localhost:8000),
# so leave empty for local. On Vercel, set to your hosted backend, e.g.:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=

# Required only for the Map tab
VITE_GOOGLE_MAPS_API_KEY=your_key_here
